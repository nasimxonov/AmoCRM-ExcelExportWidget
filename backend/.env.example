# Server
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:3001
WIDGET_URL=http://localhost:5173

# PostgreSQL (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/excel_export?schema=public"

# Redis (optional — leave empty to fall back to the in-memory queue adapter,
# which is fine for a single backend instance / development use)
REDIS_URL=

# amoCRM (Kommo) Private Integration — Settings -> Integrations -> your
# integration -> "Keys and scopes" tab. See docs/AMOCRM_SETUP.md.
AMOCRM_SUBDOMAIN=yourcompany
AMOCRM_LONG_LIVED_TOKEN=

# Signs short-lived widget session JWTs issued by POST /api/auth/session.
# Unrelated to amoCRM auth — this is this app's own session token.
JWT_SECRET=
JWT_EXPIRES_IN=12h

# CORS: comma separated list of allowed origins (your amoCRM subdomain + widget host)
CORS_ORIGINS=http://localhost:5173

# Directory where generated .xlsx files are staged before download/streaming
EXPORT_STORAGE_DIR=./storage/exports

# Rate limiting (requests per window per IP) for the public API surface
THROTTLE_TTL=60
THROTTLE_LIMIT=120
