generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Single row caching the amoCRM account that owns this deployment's Private
/// Integration long-lived token (see AMOCRM_SUBDOMAIN/AMOCRM_LONG_LIVED_TOKEN).
/// Populated automatically at boot by AmoCrmAccountBootstrapService.
model AmoAccount {
  id            Int            @id @default(autoincrement())
  accountId     BigInt         @unique
  subdomain     String
  connectedAt   DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  exportJobs    ExportJob[]
  googleAccount GoogleAccount?

  @@map("amo_accounts")
}

/// A Google account connected via OAuth to this amoCRM account, used to write
/// rows to Google Sheets when a Digital Pipeline trigger fires. Tokens are
/// encrypted at rest with GOOGLE_TOKEN_ENCRYPTION_KEY — see backend/src/google/crypto/token-cipher.ts.
model GoogleAccount {
  id                    Int        @id @default(autoincrement())
  account               AmoAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId             Int        @unique
  googleEmail           String
  refreshTokenEncrypted String
  accessTokenEncrypted  String?
  accessTokenExpiresAt  DateTime?
  connectedAt           DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@map("google_accounts")
}

enum ExportEntityTypeDb {
  leads
  contacts
  companies
}

enum ExportJobStatusDb {
  pending
  processing
  completed
  failed
  cancelled
}

/// Persisted state of a background export job so progress survives process
/// restarts and can be polled/streamed by the frontend.
model ExportJob {
  id             String             @id @default(uuid())
  account        AmoAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId      Int
  entityType     ExportEntityTypeDb
  status         ExportJobStatusDb  @default(pending)
  requestPayload Json
  processed      Int                @default(0)
  total          Int                @default(0)
  stage          String             @default("fetching")
  fileName       String?
  filePath       String?
  errorMessage   String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  completedAt    DateTime?

  @@index([accountId, status])
  @@map("export_jobs")
}
